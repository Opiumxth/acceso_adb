# Copiar este archivo a ".env" y completar las claves.
# El archivo .env NO se sube al repositorio (esta en .gitignore).
# Las claves de los usuarios de la base estan en sql/00_admin.sql.

# --- Oracle (contenedor "oracle-xe", servicio XEPDB1) ---
ORACLE_DSN=localhost:1521/XEPDB1
ORACLE_SCHEMA=ACCESO_OWNER

# Un usuario por rol. Si se omite el usuario se usa el valor por defecto.
DB_USER_PUNTO=u_punto
DB_PASSWORD_PUNTO=
DB_USER_VIGILANTE=u_vigilante
DB_PASSWORD_VIGILANTE=
DB_USER_DOCENTE=u_docente
DB_PASSWORD_DOCENTE=
DB_USER_ADMIN=u_admin
# Si se deja vacia, el menu de consola pide la clave de u_admin al entrar a
# las opciones de administracion (recomendado en el equipo del punto de acceso).
DB_PASSWORD_ADMIN=

# --- Punto de acceso y camara ---
# Punto de control de este equipo (ver tabla puntos_control)
ID_PUNTO=1
CAMERA_INDEX=0
QR_TIMEOUT_SEGUNDOS=30
ROSTRO_TIMEOUT_SEGUNDOS=20

# --- Datos biometricos (rostros, modelos y QR); fuera del repositorio ---
# DATOS_DIR=/ruta/a/datos

# --- Panel web (Flask): ./venv/bin/python src/app.py ---
# Clave de ingreso al panel de cada rol (distinta de las claves de Oracle).
# Un rol sin clave no puede ingresar.
PANEL_PASSWORD_ADMIN=
PANEL_PASSWORD_VIGILANTE=
PANEL_PASSWORD_DOCENTE=
# Firma de las sesiones. Si se omite se genera una al arrancar (las sesiones se pierden al reiniciar).
# PANEL_SECRET_KEY=
# PANEL_HOST=127.0.0.1
# PANEL_PORT=5000
